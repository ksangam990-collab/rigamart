# Dependencies
**/node_modules/

# Production build artifacts
**/dist/
**/dist-ssr/

# Environment configurations and secrets (NEVER commit secrets)
**/.env
**/.env.*
!**/.env.example

# Logs and debuggers
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# System & IDE files
**/.DS_Store
**/.idea/
**/.vscode/*
!**/.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary test outputs & sample files
sample_invoice.pdf
**/sample_invoice.pdf
**/uploads/*
!**/uploads/.gitkeep
